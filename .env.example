# Copy to .env and fill in real values. Never commit .env.

# Root directory holding the Open-I chest X-ray dataset (images + reports).
OPENI_ROOT=data/openi

# TorchXRayVision DenseNet-121 weights identifier used by reader_a (the CNN).
CNN_WEIGHTS=densenet121-res224-all

# Probability threshold above which reader_a calls a pathology positive.
CNN_PROB_THRESHOLD=0.5

# Probability threshold above which a finding triggers the critical-triage
# alert channel. Deliberately lower than CNN_PROB_THRESHOLD: over-calling a
# critical finding is acceptable, missing one is not (gate G1).
CRITICAL_THRESHOLD=0.3

# "reader" = reader_b emits structured findings directly; "describer" =
# reader_b only free-text describes the image and findings are derived later.
READER_B_MODE=reader

# Generative VLM connection info for reader_b (OpenAI-compatible endpoint,
# e.g. a SiliconFlow-hosted Qwen-VL model).
#
# VLM_MODEL is left blank deliberately -- it was NOT verified
# against a live provider catalogue as of Task 2.1, because no
# VLM_API_KEY was present in this environment to query
# `{VLM_BASE_URL}/models` with. Do not guess/hardcode a model id
# here from memory: a sibling project shipped a hardcoded id that didn't
# exist in the provider's catalogue and failed at runtime with "Model does
# not exist". Once a real key is available, query the `/models` endpoint,
# pick the actual Qwen-VL id from the response, and record it here.
VLM_MODEL=
VLM_BASE_URL=
VLM_API_KEY=

# Minimum acceptable inter-reader agreement (Cohen's kappa) before the study
# is flagged as needing extra scrutiny.
KAPPA_FLOOR=0.4

# Maximum fraction of findings allowed to disagree before escalating.
DISAGREEMENT_CEILING=0.4

# Cap on how many disagreements get sent to the LLM arbiter per study
# (cost/latency control).
MAX_LLM_JUDGMENTS=12

# Set true to call a real VLM for reader_b instead of a stub/mock.
USE_REAL_VLM=false

# Run-persistence backend for the workbench (Task 3.3): "memory" (default,
# process-local, lost on restart) or "sqlite" (stdlib sqlite3, durable
# across restarts).
RUN_STORE=memory

# Path to the SQLite database file when RUN_STORE=sqlite. Use
# ":memory:" for a non-durable in-process database.
SQLITE_PATH=data/runs.sqlite3

# Langfuse tracing. Tracing is enabled only when BOTH keys below are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
